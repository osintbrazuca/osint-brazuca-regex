{
    "boleto": [
        {
            "regex": "(\\d{5}[\\.]\\d{5}[\\s]\\d{5}[\\.]\\d{6}[\\s]\\d{5}[\\.]\\d{6}[\\s]\\d[\\s]\\d{14})|(\\d{47,48})|(\\d{12} \\d{12} \\d{12} \\d{12})",
            "description": "Boleto Bancário e Linha Digitável"
        },
        {
            "regex": "\\b8[1-4]\\d{42}\\b|\\b\\d{11}-\\d\\s\\d{11}-\\d\\s\\d{11}-\\d\\s\\d{11}-\\d\\b",
            "description": "Boleto de arrecadação/concessionária - código de barras (44 dígitos, inicia com 8) e linha digitável"
        }
    ],
    "cadastur": [
        {
            "regex": "([0-9]{2}[\\.]?[0-9]{3}[\\.]?[0-9]{3}[/]?[0-9]{4}[-]?[0-9]{2})",
            "description": "Cadastro de Prestadores de Serviços Turísticos"
