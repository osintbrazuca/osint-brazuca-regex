{
    "cryptoWallets": [
        {
            "regex": "^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,39}$",
            "description": "Bitcoin (BTC) - Endereço de carteira"
        },
        {
            "regex": "^0x[a-fA-F0-9]{40}$",
            "description": "Ethereum e tokens ERC-20 (ETH, USDT, USDC) - endereço EVM, válido também em Polygon/BSC/Arbitrum"
        },
        {
            "regex": "^T[a-zA-Z0-9]{33}$",
            "description": "Tether USDT (TRC-20) - Endereço na rede Tron"
        },
        {
            "regex": "^(bnb1|0x)[a-zA-Z0-9]{38,42}$",
            "description": "BNB (Binance Coin) - Endereço de carteira"
        },
        {
            "regex": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
            "description": "Solana (SOL) - Endereço de carteira (Base58)"
        },
        {
            "regex": "^r[a-zA-Z0-9]{24,34}$",
            "description": "XRP (Ripple) - Endereço de carteira"
        },
        {
            "regex": "^(addr1|stake1)[a-z0-9]{53,}$",
            "description": "Cardano (ADA) - Endereço de carteira (Shelley)"
        },
        {
            "regex": "^D[5-9A-HJ-NP-U][1-9A-HJ-NP-Za-km-z]{32}$",
            "description": "Dogecoin (DOGE) - Endereço de carteira"
        },
        {
            "regex": "^(L|M|ltc1)[a-zA-Z0-9]{26,42}$",
            "description": "Litecoin (LTC) - Endereço de carteira"
        },
        {
            "regex": "^(0x[a-fA-F0-9]{40}|T[a-zA-Z0-9]{33}|[13][a-zA-Z0-9]{26,35}|bc1[a-z0-9]{39,59})$",
            "description": "Carteiras multi-chain (ETH/USDT/BTC) - Detecção genérica"
        },
        {
            "regex": "\\b[48][0-9AB][1-9A-HJ-NP-Za-km-z]{93}\\b",
            "description": "Monero (XMR) - Endereço padrão (4...) ou subendereço (8...)"
        },
        {
            "regex": "\\bbc1p[023456789acdefghjklmnpqrstuvwxyz]{58}\\b",
            "description": "Bitcoin Taproot (BTC) - Endereço bech32m (bc1p)"
        },
        {
            "regex": "\\b(?:xpub|ypub|zpub|xprv|yprv|zprv)[1-9A-HJ-NP-Za-km-z]{107,108}\\b",
            "description": "Chave estendida BIP-32 (xpub/ypub/zpub e privadas xprv/yprv/zprv)"
        },
        {
            "regex": "\\bG[A-Z2-7]{55}\\b",
            "description": "Stellar (XLM) - Endereço de carteira"
        },
        {
            "regex": "\\b(?:bitcoincash:)?[qp][a-z0-9]{41}\\b",
            "description": "Bitcoin Cash (BCH) - Endereço CashAddr"
        },
        {
            "regex": "\\b(?:[a-z]{3,8}\\s+){11}[a-z]{3,8}\\b",
            "description": "Seed phrase BIP-39 (12 palavras) - alto recall, exige validação contra a wordlist oficial"
        }
    ],
    "data": [
        {
            "regex": "\\b(0[1-9]|[12]\\d|3[01])[\\/.-](0[1-9]|1[0-2])[\\/.-](19|20)\\d{2}\\b",
            "description": "Data dd-mm-yyyy | dd/mm/yyyy | dd.mm.yyyy"
        }
    ],
    "email": [
        {
            "regex": "([\\w._%+-]+)(@|\\s@\\s|\\sat\\s|\\[at\\])([\\w.-]+)\\.([\\w]{2,})",
            "description": "Endereço de email"
        }
    ],
    "hora12": [
        {
            "regex": "\\b(0?[1-9]|1[0-2]):[0-5][0-9]\\s?[AaPp]\\.?[Mm]\\.?",
            "description": "Hora no formato 12h"
        }
    ],
    "hora24": [
        {
            "regex": "([01][0-9]|[2][0-3]):([0-5][0-9])",
            "description": "Hora no formato 24h"
        }
    ],
    "network": [
        {
            "regex": "(?<![\\d.])(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?!\\.\\d)",
            "description": "IPv4 - Endereço IP versão 4 (não casa dentro de sequências pontuadas maiores)"
        },
        {
            "regex": "(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))",
            "description": "IPv6 - Endereço IP versão 6"
        },
        {
            "regex": "(?:[0-9A-Fa-f]{2}[:-]){5}(?:[0-9A-Fa-f]{2})",
            "description": "MAC Address - Media Access Control"
        },
        {
            "regex": "\\b(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}\\b",
            "description": "Domínio - Nome de domínio genérico"
        },
        {
            "regex": "\\b(?:[a-zA-Z0-9-]+\\.){2,}[a-zA-Z]{2,}\\b",
            "description": "Domínio + Subdomínio - Domínio com subdomínios"
        },
        {
            "regex": "\\b(?:[a-zA-Z0-9-]+\\.)+br\\b",
            "description": "Domínio .br - Domínios brasileiros (TLD .br)"
        },
        {
            "regex": "(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+(?:com\\.br|gov\\.br|org\\.br|net\\.br|edu\\.br|mil\\.br|art\\.br|eco\\.br|emp\\.br|adv\\.br|nom\\.br|blog\\.br|jus\\.br|leg\\.br|ind\\.br|coop\\.br|rec\\.br|srv\\.br|tmp\\.br|tur\\.br|tv\\.br|agr\\.br|am\\.br|cim\\.br|cnt\\.br|esp\\.br|etc\\.br|eti\\.br|far\\.br|flog\\.br|fm\\.br|fnd\\.br|fot\\.br|fst\\.br|g12\\.br|ggf\\.br|imb\\.br|inf\\.br|med\\.br|mus\\.br|not\\.br|ntr\\.br|odo\\.br|ppg\\.br|pro\\.br|psc\\.br|psi\\.br|qsl\\.br|radio\\.br|slg\\.br|taxi\\.br|teo\\.br|vlog\\.br|wiki\\.br|zlg\\.br|br)",
            "description": "Domínio .br completo - Todos os subdomínios brasileiros"
        },
        {
            "regex": "\\b(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}:\\d{1,5}\\b",
            "description": "Domínio com porta - Domínio incluindo número de porta"
        },
        {
            "regex": "\\bhttps?:\\/\\/[^\\s\\/$.?#].[^\\s]*\\b",
            "description": "URL - URL completa (formato otimizado)"
        },
        {
            "regex": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()!@:%_\\+.~#?&\\/\\/=]*)",
            "description": "URL - Uniform Resource Locator completa (formato tradicional)"
        },
        {
            "regex": "\\b(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}\\/[^\\s]*\\b",
            "description": "URL - Domínio com caminho (sem protocolo)"
        },
        {
            "regex": "(?:https?:\\/\\/)?(?:www\\.)?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.br(?:\\/[^\\s]*)?",
            "description": "URL .br - URLs com domínio brasileiro"
        },
        {
            "regex": "\\b(?:bit\\.ly|t\\.co|tinyurl\\.com|goo\\.gl|ow\\.ly|is\\.gd|cutt\\.ly)\\/[a-zA-Z0-9_-]+\\b",
            "description": "URL Encurtada - Serviços de encurtamento de URL (bit.ly, t.co, etc)"
        },
        {
            "regex": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\/(?:3[0-2]|[12]?\\d)\\b",
            "description": "CIDR IPv4 - Bloco de rede"
        },
        {
            "regex": "\\bAS\\d{1,10}\\b",
            "description": "ASN - Número de Sistema Autônomo"
        }
    ],
