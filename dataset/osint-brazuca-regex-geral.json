    "torDarkWeb": [
        {
            "regex": "\\b[a-z2-7]{16}\\.onion\\b",
            "description": "Tor Hidden Service - Endereço .onion v2 (16 caracteres)"
        },
        {
            "regex": "\\b[a-z2-7]{56}\\.onion\\b",
            "description": "Tor Hidden Service - Endereço .onion v3 (56 caracteres)"
        },
        {
            "regex": "\\b[a-z2-7]{16,56}\\.onion\\b",
            "description": "Tor Hidden Service - Qualquer endereço .onion (v2 ou v3)"
        }
    ],
    "creditCard": [
        {
            "regex": "4[0-9]{12}(?:[0-9]{3})?",
            "description": "Visa - Cartão de crédito (13 ou 16 dígitos começando com 4)"
        },
        {
            "regex": "(?:5[1-5][0-9]{2}|222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)[0-9]{12}",
            "description": "Mastercard - Cartão de crédito (16 dígitos)"
        },
        {
            "regex": "3[47][0-9]{13}",
            "description": "American Express - Cartão de crédito (15 dígitos começando com 34 ou 37)"
        },
        {
            "regex": "3(?:0[0-5]|[68][0-9])[0-9]{11}",
            "description": "Diners Club - Cartão de crédito (14 dígitos)"
        },
        {
            "regex": "(?:4[0-9]{12}(?:[0-9]{3})?|(?:5[1-5][0-9]{2}|222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)[0-9]{12}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|6(?:011|5[0-9]{2})[0-9]{12}|(?:2131|1800|35\\d{3})\\d{11})",
            "description": "Cartão de Crédito - Detecção genérica (Visa, Master, Amex, Diners, Discover, JCB)"
        },
        {
            "regex": "(?:[0-9]{4}[\\s-]?){3}[0-9]{4}",
            "description": "Cartão de Crédito - Formato com espaços ou hífens (#### #### #### ####)"
        }
    ],
    "UUID": [
        {
            "regex": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\\b",
            "description": "UUID - Universally Unique Identifiers (versões 1 a 8)"
        }
    ],
    "verificacaoDeSenha": [
        {
            "regex": "(?=.*[A-Z])(?=.*[a-z])(?=.*\\d)(?=.*[@#$%&*!+\\-]).{8,20}",
            "description": "Validador de senhas com tamanho entre 8 e 20 dígitos e com letras maiúsculas, minúsculas, números e caracteres especiais"
        }
    ],
    "isbn": [
        {
            "regex": "(?:ISBN(?:-1[03])?:?\\s?)?(?=[0-9X]{10}$|(?=(?:[0-9]+[-\\s]){3})[-\\s0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[-\\s]){4})[-\\s0-9]{17}$)(?:97[89][-\\s]?)?[0-9]{1,5}[-\\s]?[0-9]+[-\\s]?[0-9]+[-\\s]?[0-9X]",
            "description": "International Standard Book Number"
        }
    ],
    "ean13": [
        {
            "regex": "^\\d{13}$",
            "description": "Código de Barras EAN-13 - produtos"
        }
    ],
    "socialMedia": [
