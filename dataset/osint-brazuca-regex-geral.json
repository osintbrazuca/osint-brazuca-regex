        {
            "regex": "\\$2[aby]?\\$\\d{2}\\$[.\\/A-Za-z0-9]{53}",
            "description": "Hash bcrypt"
        },
        {
            "regex": "\\b[a-fA-F0-9]{128}\\b",
            "description": "Hash SHA-512 - 128 caracteres hexadecimais"
        }
    ],
